# EVOLVE Environment Configuration

PORT=5000
NODE_ENV=development

# Multi-Tenant Authentication & Cryptography
JWT_SECRET=evolve_production_jwt_secret_change_me_in_prod
DEMO_MODE=true

# MongoDB Persistence
MONGO_URI=mongodb://localhost:27017/evolve

# Redis (BullMQ Queue Dispatch)
REDIS_HOST=localhost
REDIS_PORT=6379

# Docker Engine (Windows named pipe or Linux unix socket)
# Windows: //./pipe/docker_engine
# Linux/macOS: /var/run/docker.sock
DOCKER_SOCKET_PATH=//./pipe/docker_engine

# File Uploads & Quota Guards
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Sandbox Defaults & Resource Bounds
SANDBOX_CPU_LIMIT=1000000000
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_PIDS_LIMIT=100
SANDBOX_TIMEOUT_MS=60000

# Load Testing & Telemetry
K6_BIN_PATH=k6
DEFAULT_LOAD_PROFILE=load

# Contextual Bandit Policy Engine & Analyzer (Phase 5)
POLICY_MODE=learned
ANALYZER_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333
